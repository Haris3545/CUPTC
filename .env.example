# Copy to .env for local testing (npm run dev). On Vercel, set these under Project → Settings → Environment Variables.
MEMBER_PASSWORD=
COMMITTEE_PASSWORD=
FULL_MEMBER_CODE=
COMMITTEE_DISCOUNT_CODE=
# Any long random string. Changing it signs everyone out.
AUTH_SECRET=
# From the Stripe dashboard (sk_live_... or sk_test_...). Leave empty until payments are ready.
STRIPE_SECRET_KEY=
# "on" shows a simulated checkout when there is no Stripe key. Never leave on for the public site.
DEMO_PAYMENTS=
# Set automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=
